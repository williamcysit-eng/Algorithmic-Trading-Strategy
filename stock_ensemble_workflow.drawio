        <mxCell id="p5-out-bg" value="&lt;b&gt;C • OUTPUT CONTRACT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1180" height="380" as="geometry"/></mxCell>
        <mxCell id="p5-research" value="&lt;b&gt;Research evidence — &lt;font face=&quot;Courier New&quot;&gt;results/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Performance&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;metrics.csv&lt;br&gt;zero_cost_metrics.csv&lt;br&gt;annual_returns.csv&lt;br&gt;returns.csv&lt;br&gt;equity_curves.png&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Inference&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;paired_holdout_intervals.csv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=12;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="75" y="730" width="330" height="270" as="geometry"/></mxCell>
        <mxCell id="p5-audit" value="&lt;b&gt;Audit trail — &lt;font face=&quot;Courier New&quot;&gt;results/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;holdings.csv.gz&lt;br&gt;weights.csv&lt;br&gt;scores.csv.gz&lt;br&gt;features.csv.gz&lt;br&gt;coverage.csv&lt;br&gt;run_manifest.json&lt;/font&gt;&lt;br&gt;&lt;br&gt;Contains selections, signal/entry dates, target weights, label ends, fit windows, source hashes, provenance, limitations and references." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F5;strokeColor=#277C7C;strokeWidth=2;fontColor=#174E4E;fontSize=12;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="730" width="340" height="270" as="geometry"/></mxCell>
        <mxCell id="p5-liveout" value="&lt;b&gt;Live decision package&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;rankings.csv&lt;br&gt;ranking_models.json&lt;br&gt;allocations.csv&lt;br&gt;allocation_assumptions.json&lt;br&gt;dividend_notifications.csv&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Each allocation row must show&lt;/b&gt;&lt;br&gt;horizon, signal/entry/evaluation date, ticker/name, score, 20% target, nominal close, $200,000 allocation, fractional shares, evaluation status, price return, dividend cash, ending value excluding dividends." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF2E6;strokeColor=#2F7D4A;strokeWidth=3;fontColor=#174529;fontSize=12;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="815" y="715" width="370" height="300" as="geometry"/></mxCell>

        <mxCell id="p5-code-bg" value="&lt;b&gt;D • IMPLEMENTATION OWNERSHIP &amp;amp; QA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1245" y="660" width="635" height="380" as="geometry"/></mxCell>
        <mxCell id="p5-modules" value="&lt;b&gt;Module map&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;data.py&lt;/font&gt; — Yahoo/SEC, vintages, actions&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;features.py&lt;/font&gt; — experts, eligibility, gate&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;model.py&lt;/font&gt; — simplex-constrained fit&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;backtest.py&lt;/font&gt; — labels, purge, portfolios, metrics&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;reporting.py&lt;/font&gt; — artifacts, plots, bootstrap&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;cli.py&lt;/font&gt; — download, backtest, rank, allocate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontColor=#374151;fontSize=12;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1280" y="720" width="565" height="140" as="geometry"/></mxCell>
        <mxCell id="p5-qa" value="&lt;b&gt;Release checklist&lt;/b&gt;&lt;br&gt;✓ archive raw + normalized data and checksums&lt;br&gt;✓ run all 13 tests; rerun full backtest after snapshot/config changes&lt;br&gt;✓ inspect label_end &amp;lt; refit_date and signal_date &amp;lt; entry_date&lt;br&gt;✓ confirm weights sum to 1 and ≤5 stocks per assignment portfolio&lt;br&gt;✓ keep zero-cost/cost-sensitive results separate; notify dividends&lt;br&gt;✓ disclose survivor bias, uncertainty and unadjusted multiple tests&lt;br&gt;✓ never fabricate future exits or silently update locked decisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=11;align=left;verticalAlign=top;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1280" y="875" width="565" height="145" as="geometry"/></mxCell>
