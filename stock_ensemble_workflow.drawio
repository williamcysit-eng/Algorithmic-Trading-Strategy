  <diagram id="research-system" name="1. Executive Research System">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1-title" value="STAT7008 Earnings–Momentum Stock-Ranking Ensemble" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1840" height="42" as="geometry"/></mxCell>
        <mxCell id="p1-subtitle" value="Executive overview • point-in-time data → horizon-specific ranking → constrained portfolios → auditable evidence" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52677A;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1800" height="28" as="geometry"/></mxCell>
        <mxCell id="p1-goal" value="&lt;b&gt;Desired output&lt;/b&gt;: three separately evaluated, fully invested US-equity portfolios — &lt;b&gt;$1,000,000 each&lt;/b&gt;, at most five stocks, long-only, no borrowing, no short selling, no ETFs; nominal closing-price returns over daily, weekly and monthly horizons." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=15;align=left;verticalAlign=middle;spacing=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1840" height="62" as="geometry"/></mxCell>

        <mxCell id="p1-c-input" value="&lt;b&gt;1 • INPUTS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="300" height="790" as="geometry"/></mxCell>
        <mxCell id="p1-c-data" value="&lt;b&gt;2 • POINT-IN-TIME DATA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="350" y="180" width="350" height="790" as="geometry"/></mxCell>
        <mxCell id="p1-c-feature" value="&lt;b&gt;3 • EXPERT FEATURES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="420" height="790" as="geometry"/></mxCell>
        <mxCell id="p1-c-model" value="&lt;b&gt;4 • LABELS &amp;amp; MODEL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1160" y="180" width="330" height="790" as="geometry"/></mxCell>
        <mxCell id="p1-c-output" value="&lt;b&gt;5 • DECISION &amp;amp; EVIDENCE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1510" y="180" width="380" height="790" as="geometry"/></mxCell>

        <mxCell id="p1-yahoo" value="&lt;b&gt;Yahoo chart data&lt;/b&gt;&lt;br&gt;2010-01-04–2025-12-31&lt;br&gt;close, adjusted close, volume, dividends, splits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="235" width="240" height="112" as="geometry"/></mxCell>
        <mxCell id="p1-sec" value="&lt;b&gt;SEC Companyfacts&lt;/b&gt;&lt;br&gt;filing vintages, accession IDs, concepts, fiscal periods, filed dates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="240" height="112" as="geometry"/></mxCell>
        <mxCell id="p1-config" value="&lt;b&gt;Fixed design inputs&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;config.json&lt;/font&gt; + &lt;font face=&quot;Courier New&quot;&gt;universe.csv&lt;/font&gt;&lt;br&gt;30 named US stocks, CIK, name, sector; hyperparameters and paths" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="240" height="132" as="geometry"/></mxCell>
        <mxCell id="p1-sample" value="&lt;b&gt;Reproducibility inputs&lt;/b&gt;&lt;br&gt;raw response cache + normalized CSV checksums&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;data/manifest.json&lt;/font&gt;&lt;br&gt;&lt;br&gt;Offline sample: 10 real stocks, 2022–2025; demonstration only, not full-result evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontColor=#374151;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="240" height="190" as="geometry"/></mxCell>

        <mxCell id="p1-ingest" value="&lt;b&gt;Download, cache, validate&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;stock_ensemble/data.py&lt;/font&gt;&lt;br&gt;exclusive end date; completed sessions only; cached snapshots reused only when coverage is sufficient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F5;strokeColor=#277C7C;strokeWidth=2;fontColor=#174E4E;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="235" width="290" height="125" as="geometry"/></mxCell>
        <mxCell id="p1-prices" value="&lt;b&gt;Validated price panel&lt;/b&gt;&lt;br&gt;120,720 ticker-session rows&lt;br&gt;split-aware nominal close reconstructed for assignment returns&lt;br&gt;adjusted close retained for feature formation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F5;strokeColor=#277C7C;strokeWidth=2;fontColor=#174E4E;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="390" width="290" height="145" as="geometry"/></mxCell>
        <mxCell id="p1-earnings" value="&lt;b&gt;Point-in-time earnings events&lt;/b&gt;&lt;br&gt;1,732 disclosures&lt;br&gt;earliest usable filing wins; late restatements cannot rewrite history; coherent income concept retained; Q4 may be annual less 9M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F5;strokeColor=#277C7C;strokeWidth=2;fontColor=#174E4E;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="565" width="290" height="152" as="geometry"/></mxCell>
        <mxCell id="p1-data-rules" value="&lt;b&gt;Data integrity rules&lt;/b&gt;&lt;br&gt;• no duplicate ticker/session or ticker/filing rows&lt;br&gt;• missing held prices raise errors&lt;br&gt;• split events change shares, not wealth&lt;br&gt;• dividends are explicit and separately notified&lt;br&gt;• hashes preserve source provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="747" width="290" height="168" as="geometry"/></mxCell>

        <mxCell id="p1-eligibility" value="&lt;b&gt;Eligibility filter at signal close d&lt;/b&gt;&lt;br&gt;complete 252-session adjusted-price history; nominal close ≥ $5; prior 20-session mean dollar volume ≥ $10m; at least 10 eligible stocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="750" y="225" width="360" height="122" as="geometry"/></mxCell>
        <mxCell id="p1-f-earn" value="&lt;b&gt;Expert 1 — Earnings&lt;/b&gt;&lt;br&gt;seasonal quarterly GAAP-profit change ÷ quarter-end assets; standardized by up to 8 prior observable changes (minimum 4); centered rank; 45-day half-life; expires at 180 days; unavailable = neutral" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="750" y="375" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="p1-f-mom" value="&lt;b&gt;Expert 2 — 12−1 momentum&lt;/b&gt;&lt;br&gt;adjusted close(d−21) ÷ adjusted close(d−252) − 1; latest month skipped; cross-sectional centered rank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="750" y="555" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="p1-f-rev" value="&lt;b&gt;Expert 3 — Short reversal + gate&lt;/b&gt;&lt;br&gt;−[stock return − equal-weight universe return] ÷ volatility(d−20…d−1)&lt;br&gt;Bad-news gate on positive rebound credit:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 − max(−tanh(surprise),0) × 2^(−age/10)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="750" y="690" width="360" height="160" as="geometry"/></mxCell>
        <mxCell id="p1-ranks" value="&lt;b&gt;Common representation&lt;/b&gt; • eligible cross-sectional average ranks mapped to [−1, 1]; scores are relative rankings, not expected returns or probabilities." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="750" y="875" width="360" height="64" as="geometry"/></mxCell>

        <mxCell id="p1-labels" value="&lt;b&gt;Horizon-specific targets&lt;/b&gt;&lt;br&gt;signal at close d → enter close d+1 → exit close d+1+h&lt;br&gt;h ∈ {1, 5, 20} sessions; target = cross-sectional rank of subsequent nominal price return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B64A4A;strokeWidth=2;fontColor=#6E2525;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1190" y="235" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="p1-training" value="&lt;b&gt;Purged monthly refit&lt;/b&gt;&lt;br&gt;rolling 756 sessions; ≥252 training dates; only labels with &lt;font face=&quot;Courier New&quot;&gt;label_end &amp;lt; refit_date&lt;/font&gt;; date-balanced observations; prequential holdout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B64A4A;strokeWidth=2;fontColor=#6E2525;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1190" y="405" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="p1-optimizer" value="&lt;b&gt;Constrained rank ensemble&lt;/b&gt;&lt;br&gt;non-negative weights; sum = 1; three-variable quadratic fit; ridge 0.05 toward equal weights; every simplex face solved; no neural network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B64A4A;strokeWidth=2;fontColor=#6E2525;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1190" y="580" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="p1-strategies" value="&lt;b&gt;Seven evaluated strategies&lt;/b&gt;&lt;br&gt;• learned gated ensemble&lt;br&gt;• learned ungated ablation&lt;br&gt;• equal-signal blend&lt;br&gt;• earnings, momentum, reversal alone&lt;br&gt;• equal-weight eligible universe benchmark" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontColor=#374151;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1190" y="740" width="270" height="175" as="geometry"/></mxCell>

        <mxCell id="p1-h1" value="&lt;b&gt;DAILY&lt;/b&gt;&lt;br&gt;h = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=14;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1540" y="235" width="95" height="76" as="geometry"/></mxCell>
        <mxCell id="p1-h5" value="&lt;b&gt;WEEKLY&lt;/b&gt;&lt;br&gt;h = 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=14;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1650" y="235" width="95" height="76" as="geometry"/></mxCell>
        <mxCell id="p1-h20" value="&lt;b&gt;MONTHLY&lt;/b&gt;&lt;br&gt;h = 20 proxy&lt;br&gt;19 exact in 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1760" y="225" width="100" height="96" as="geometry"/></mxCell>
        <mxCell id="p1-portfolio" value="&lt;b&gt;Self-financing portfolio&lt;/b&gt;&lt;br&gt;top five by horizon score; equal dollar weights; $1m initial capital per horizon; fractional shares; next-close execution; holdings drift; non-overlapping rebalances; final partial interval marked and liquidated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1540" y="360" width="320" height="175" as="geometry"/></mxCell>
        <mxCell id="p1-evaluate" value="&lt;b&gt;Evaluation contract&lt;/b&gt;&lt;br&gt;price return default; dividends excluded and notified; zero cost for assignment; 10 bps per dollar bought/sold as sensitivity; total-return mode optional and separate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1540" y="565" width="320" height="145" as="geometry"/></mxCell>
        <mxCell id="p1-artifacts" value="&lt;b&gt;Desired evidence package&lt;/b&gt;&lt;br&gt;rankings + allocations + shares; daily NAV/returns/costs; holdings and fitted weights; metrics and annual returns; paired block-bootstrap intervals; coverage, manifests, hashes, plots and dividend notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF2E6;strokeColor=#2F7D4A;strokeWidth=3;fontColor=#174529;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1540" y="745" width="320" height="170" as="geometry"/></mxCell>

        <mxCell id="p1-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#356A9A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-yahoo" target="p1-ingest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#356A9A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-sec" target="p1-ingest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#277C7C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-ingest" target="p1-prices"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e6" value="↗" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#6B4FA1;" vertex="1" parent="1"><mxGeometry x="680" y="325" width="70" height="70" as="geometry"/></mxCell>
        <mxCell id="p1-e7" value="↗" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#6B4FA1;" vertex="1" parent="1"><mxGeometry x="680" y="505" width="70" height="70" as="geometry"/></mxCell>
        <mxCell id="p1-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B4FA1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-f-rev" target="p1-ranks"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B64A4A;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-ranks" target="p1-training"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="907"/><mxPoint x="1150" y="477"/></Array></mxGeometry></mxCell>
        <mxCell id="p1-e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B64A4A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-labels" target="p1-training"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B64A4A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-training" target="p1-optimizer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e16" value="↗" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#3D7A57;" vertex="1" parent="1"><mxGeometry x="1460" y="505" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="p1-e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3D7A57;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-h1" target="p1-portfolio"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3D7A57;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-h5" target="p1-portfolio"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3D7A57;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-h20" target="p1-portfolio"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3D7A57;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-portfolio" target="p1-evaluate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F7D4A;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-evaluate" target="p1-artifacts"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p1-legend" value="&lt;b&gt;Legend&lt;/b&gt;   Blue = external/fixed inputs   •   Teal = validated point-in-time data   •   Purple = expert features   •   Red = supervised fitting boundary   •   Green = portfolio decision/output   •   Amber = assumptions/controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontColor=#475569;fontSize=12;align=center;verticalAlign=middle;spacing=8;arcSize=5;" vertex="1" parent="1"><mxGeometry x="210" y="982" width="1500" height="64" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="chronology" name="2. Chronology and No-Look-Ahead">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2-title" value="Point-in-Time Chronology and Leakage Controls" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1840" height="42" as="geometry"/></mxCell>
        <mxCell id="p2-subtitle" value="The central invariant: a ranking must be reproducible using only information available strictly before execution." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52677A;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1800" height="28" as="geometry"/></mxCell>
        <mxCell id="p2-rule" value="&lt;b&gt;NO LOOK-AHEAD&lt;/b&gt; • Future prices, future filings, late restatements and labels that have not finished by the refit date are prohibited from changing any earlier score, fit or holding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B64A4A;strokeWidth=2;fontColor=#6E2525;fontSize=15;align=center;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1840" height="62" as="geometry"/></mxCell>

        <mxCell id="p2-c-time" value="&lt;b&gt;A • INFORMATION AND TRADE TIMELINE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="1840" height="320" as="geometry"/></mxCell>
        <mxCell id="p2-fiscal" value="&lt;b&gt;Fiscal period ends&lt;/b&gt;&lt;br&gt;Quarter q closes&lt;br&gt;&lt;font color=&quot;#B64A4A&quot;&gt;Not yet observable earnings news&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontColor=#374151;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="95" y="260" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-filed" value="&lt;b&gt;SEC filed_date = F&lt;/b&gt;&lt;br&gt;earliest usable disclosure/version retained&lt;br&gt;same-day signal still excluded" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="260" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-signal" value="&lt;b&gt;Signal close d&lt;/b&gt;&lt;br&gt;features use prices through d&lt;br&gt;earnings visible only if d &amp;gt; F&lt;br&gt;rank after close" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="250" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-entry" value="&lt;b&gt;Entry close d+1&lt;/b&gt;&lt;br&gt;top five receive 20% each&lt;br&gt;first tradable price&lt;br&gt;no same-close execution" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="250" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-hold" value="&lt;b&gt;Hold h sessions&lt;/b&gt;&lt;br&gt;daily marks d+2 … d+1+h&lt;br&gt;positions drift; missing held return = error" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1370" y="250" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-exit" value="&lt;b&gt;Exit / label end&lt;/b&gt;&lt;br&gt;close d+1+h&lt;br&gt;realized nominal price return&lt;br&gt;label now mature" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1660" y="250" width="170" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-t1" value="Fiscal end never substitutes for filing availability." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="p2-t2" value="Age = d − F must be 1–180 calendar days; filing day is conservative." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="375" y="390" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="p2-t3" value="Signal is frozen before the entry price is known." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="710" y="390" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="p2-t4" value="Initial purchase cost is charged here only in sensitivity runs." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1030" y="390" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="p2-t5" value="For h = 1, only the next close-to-close factor is realized." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1360" y="390" width="240" height="42" as="geometry"/></mxCell>
        <mxCell id="p2-t6" value="A label may train a model only after this endpoint." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1625" y="390" width="220" height="42" as="geometry"/></mxCell>
        <mxCell id="p2-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-fiscal" target="p2-filed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-filed" target="p2-signal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-signal" target="p2-entry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-entry" target="p2-hold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-hold" target="p2-exit"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p2-c-fit" value="&lt;b&gt;B • PURGED MONTHLY TRAINING AT REFIT DATE R&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1840" height="240" as="geometry"/></mxCell>
        <mxCell id="p2-window" value="&lt;b&gt;Candidate formation dates&lt;/b&gt;&lt;br&gt;rolling window begins at session R−756&lt;br&gt;feature date &amp;lt; R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="90" y="610" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-purge" value="&lt;b&gt;Maturity purge&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;label_end &amp;lt; R&lt;/font&gt;&lt;br&gt;removes every outcome not fully known before refitting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B64A4A;strokeWidth=2;fontColor=#6E2525;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="600" width="270" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-finite" value="&lt;b&gt;Training admissibility&lt;/b&gt;&lt;br&gt;finite signals + target&lt;br&gt;at least 252 distinct dates&lt;br&gt;each date receives equal total weight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="600" width="270" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-fit" value="&lt;b&gt;Fit gated + ungated weights&lt;/b&gt;&lt;br&gt;separately for h = 1, 5, 20&lt;br&gt;non-negative simplex + fixed ridge&lt;br&gt;weights frozen until next monthly refit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1160" y="600" width="290" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-preq" value="&lt;b&gt;Prequential evaluation&lt;/b&gt;&lt;br&gt;2023–2025 is chronological holdout&lt;br&gt;later refits may use earlier holdout outcomes after they mature&lt;br&gt;not a frozen-model holdout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1540" y="590" width="290" height="145" as="geometry"/></mxCell>
        <mxCell id="p2-e6" value="→" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="350" y="610" width="90" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-e7" value="→" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="710" y="610" width="90" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-e8" value="→" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1070" y="610" width="90" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-e9" value="→" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1450" y="610" width="90" height="105" as="geometry"/></mxCell>

        <mxCell id="p2-c-guards" value="&lt;b&gt;C • FEATURE TIMING AND REGRESSION GUARDS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="1840" height="235" as="geometry"/></mxCell>
        <mxCell id="p2-g1" value="&lt;b&gt;Price features&lt;/b&gt;&lt;br&gt;momentum ends at d−21; volatility uses d−20…d−1; reversal shock uses return at d after close; all feature returns use adjusted prices." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="75" y="865" width="400" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-g2" value="&lt;b&gt;Earnings features&lt;/b&gt;&lt;br&gt;strictly filing-date based; later preferred tags cannot overwrite earlier available alternatives; restatements preserve old vintages and original freshness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F5;strokeColor=#277C7C;strokeWidth=2;fontColor=#174E4E;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="515" y="865" width="400" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-g3" value="&lt;b&gt;Return basis&lt;/b&gt;&lt;br&gt;features use adjusted history to avoid false split/dividend shocks; assignment performance uses reconstructed nominal close; dividends are excluded from grade return and reported separately." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="955" y="865" width="400" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-g4" value="&lt;b&gt;Behavioral regression checks&lt;/b&gt;&lt;br&gt;future prices/filings cannot change past rankings; execution lag and full investment; no dropped missing prices; split/dividend basis; constrained fit; filing/restatement and quarter reconstruction invariants." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B64A4A;strokeWidth=2;fontColor=#6E2525;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1395" y="855" width="450" height="145" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="portfolio-evaluation" name="3. Portfolio and Evaluation Mechanics">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="Portfolio Construction, Accounting and Evaluation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1840" height="42" as="geometry"/></mxCell>
        <mxCell id="p3-subtitle" value="Every strategy shares the same dates, price basis and accounting; only the ranking rule changes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52677A;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1800" height="28" as="geometry"/></mxCell>
        <mxCell id="p3-contract" value="&lt;b&gt;Assignment constraints enforced&lt;/b&gt; • $1m per horizon • invest all capital • 1–5 companies • fractional shares • long-only • no leverage • no ETF/index holding • entry and evaluation at nominal closing prices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=15;align=center;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1840" height="60" as="geometry"/></mxCell>

        <mxCell id="p3-c-strat" value="&lt;b&gt;A • STRATEGY SET&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="410" height="790" as="geometry"/></mxCell>
        <mxCell id="p3-gated" value="&lt;b&gt;Primary: learned gated ensemble&lt;/b&gt;&lt;br&gt;horizon-specific non-negative fitted weights over earnings, momentum and gated reversal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="p3-ungated" value="&lt;b&gt;Ablation: learned ungated&lt;/b&gt;&lt;br&gt;same fit and timing, but raw reversal replaces earnings-conditioned reversal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontColor=#374151;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="350" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-equal" value="&lt;b&gt;Equal-signal blend&lt;/b&gt;&lt;br&gt;fixed one-third weight on each gated signal; no learned weight advantage assumed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontColor=#374151;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="350" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-single" value="&lt;b&gt;Single-expert controls&lt;/b&gt;&lt;br&gt;earnings-only • momentum-only • raw-reversal-only&lt;br&gt;each ranks and holds the same top-five format" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontColor=#374151;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="p3-universe" value="&lt;b&gt;Eligible-universe benchmark&lt;/b&gt;&lt;br&gt;equal-weight all eligible stocks; only comparator allowed to exceed five names; not an ETF or assignment portfolio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="740" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="p3-same" value="&lt;b&gt;Fair comparison rule&lt;/b&gt;&lt;br&gt;All seven strategies use identical eligible rows, entry dates, horizons, prices, capital and liquidation dates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="870" width="350" height="75" as="geometry"/></mxCell>

        <mxCell id="p3-c-flow" value="&lt;b&gt;B • SELF-FINANCING PORTFOLIO FLOW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="475" y="185" width="905" height="500" as="geometry"/></mxCell>
        <mxCell id="p3-rank" value="&lt;b&gt;1 • Rank&lt;/b&gt;&lt;br&gt;score eligible stocks at signal close d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="265" width="160" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-select" value="&lt;b&gt;2 • Select&lt;/b&gt;&lt;br&gt;top five; target weight 20% each" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="725" y="265" width="160" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-trade" value="&lt;b&gt;3 • Execute&lt;/b&gt;&lt;br&gt;trade at next close d+1; solve fees without borrowing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="930" y="265" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-mark" value="&lt;b&gt;4 • Mark daily&lt;/b&gt;&lt;br&gt;positions drift with returns; cash = 0 after purchase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1145" y="265" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-rebal" value="&lt;b&gt;5 • Scheduled rebalance&lt;/b&gt;&lt;br&gt;every h sessions: re-rank, then trade drifted holdings to new equal targets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1135" y="430" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="p3-liquid" value="&lt;b&gt;6 • Final-date alternative&lt;/b&gt;&lt;br&gt;mark the partial interval, sell all positions and charge terminal fee in the cost scenario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="850" y="430" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="p3-error" value="&lt;b&gt;Fail closed&lt;/b&gt;&lt;br&gt;A missing or non-positive price/return for a held stock raises an error; a losing holding is never silently removed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B64A4A;strokeWidth=2;fontColor=#6E2525;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="585" width="795" height="70" as="geometry"/></mxCell>
        <mxCell id="p3-e1" value="→" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#2F7D4A;" vertex="1" parent="1"><mxGeometry x="680" y="283" width="45" height="60" as="geometry"/></mxCell>
        <mxCell id="p3-e2" value="→" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#2F7D4A;" vertex="1" parent="1"><mxGeometry x="885" y="283" width="45" height="60" as="geometry"/></mxCell>
        <mxCell id="p3-e3" value="→" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#2F7D4A;" vertex="1" parent="1"><mxGeometry x="1100" y="283" width="45" height="60" as="geometry"/></mxCell>
        <mxCell id="p3-e4" value="↓" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#2F7D4A;" vertex="1" parent="1"><mxGeometry x="1205" y="365" width="50" height="60" as="geometry"/></mxCell>
        <mxCell id="p3-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B58119;strokeWidth=3;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="360" as="sourcePoint"/><mxPoint x="960" y="430" as="targetPoint"/><Array as="points"><mxPoint x="1230" y="400"/><mxPoint x="960" y="400"/></Array></mxGeometry></mxCell>

        <mxCell id="p3-c-account" value="&lt;b&gt;C • RETURN AND COST ACCOUNTING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="475" y="710" width="905" height="290" as="geometry"/></mxCell>
        <mxCell id="p3-price" value="&lt;b&gt;Default: price mode&lt;/b&gt;&lt;br&gt;split-aware nominal closes; excludes dividends to match grading; ex-dividend events generate notifications." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="510" y="775" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="p3-total" value="&lt;b&gt;Optional: total-return mode&lt;/b&gt;&lt;br&gt;vendor adjusted factors include distributions; output must remain separate from assignment results." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="775" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="p3-cost" value="&lt;b&gt;Two cost views&lt;/b&gt;&lt;br&gt;assignment: 0 bps&lt;br&gt;sensitivity: 10 bps per dollar bought or sold, including initial purchase, rebalances and terminal sale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="765" width="265" height="140" as="geometry"/></mxCell>
        <mxCell id="p3-formula" value="&lt;b&gt;Reported daily fields&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;gross_return = marked / previous_NAV − 1&lt;br&gt;net_return = post_fee_NAV / previous_NAV − 1&lt;br&gt;cost, turnover = dollars / previous_NAV&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1;fontColor=#374151;fontSize=12;align=left;verticalAlign=middle;spacing=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="585" y="910" width="650" height="80" as="geometry"/></mxCell>

        <mxCell id="p3-c-eval" value="&lt;b&gt;D • EVALUATION DESIGN&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1405" y="185" width="475" height="815" as="geometry"/></mxCell>
        <mxCell id="p3-period" value="&lt;b&gt;Chronological periods&lt;/b&gt;&lt;br&gt;full evaluation: 2018-01-02–2025-12-31&lt;br&gt;development: 2018–2022&lt;br&gt;holdout: 2023-01-03–2025-12-31&lt;br&gt;752 holdout sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="245" width="405" height="145" as="geometry"/></mxCell>
        <mxCell id="p3-metrics" value="&lt;b&gt;Path metrics&lt;/b&gt;&lt;br&gt;total return; 252-session CAGR; annualized volatility; zero-risk-free Sharpe; daily maximum drawdown; configured-cost mean turnover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="420" width="405" height="125" as="geometry"/></mxCell>
        <mxCell id="p3-episodes" value="&lt;b&gt;Holding-episode diagnostics&lt;/b&gt;&lt;br&gt;complete non-overlapping entry-to-exit returns; mean, median, positive fraction, best and worst; incomplete terminal episode excluded only from episode summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="575" width="405" height="135" as="geometry"/></mxCell>
        <mxCell id="p3-bootstrap" value="&lt;b&gt;Paired uncertainty&lt;/b&gt;&lt;br&gt;ensemble minus comparator on common dates; circular 20-session block bootstrap; seed 7008; 1,000 draws; 95% percentile interval; annualized arithmetic mean difference, not CAGR difference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="740" width="405" height="155" as="geometry"/></mxCell>
        <mxCell id="p3-inference" value="&lt;b&gt;Interpretation discipline&lt;/b&gt;&lt;br&gt;Intervals are not multiple-testing adjusted. Positive backtest returns, high Sharpe or an interval crossing zero do not establish future profitability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B64A4A;strokeWidth=2;fontColor=#6E2525;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="900" width="405" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="evidence" name="4. Quantitative Evidence and Verdict">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4-title" value="Recorded Quantitative Evidence and Fitness-for-Purpose Verdict" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1840" height="42" as="geometry"/></mxCell>
        <mxCell id="p4-subtitle" value="Full 30-stock snapshot • 120,720 price rows • 1,732 earnings events • 2023–2025 chronological holdout" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52677A;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1800" height="28" as="geometry"/></mxCell>

        <mxCell id="p4-primary" value="&lt;b&gt;ASSIGNMENT-CONSISTENT ENSEMBLE RESULTS — ZERO-COST NOMINAL PRICE RETURNS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=16;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1840" height="65" as="geometry"/></mxCell>
        <mxCell id="p4-table" value="&lt;table border=&quot;1&quot; cellpadding=&quot;8&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:14px&quot;&gt;&lt;tr style=&quot;background:#DFF2E6;font-weight:bold&quot;&gt;&lt;td&gt;Horizon&lt;/td&gt;&lt;td&gt;Complete episodes&lt;/td&gt;&lt;td&gt;Mean episode&lt;/td&gt;&lt;td&gt;Positive&lt;/td&gt;&lt;td&gt;Total return&lt;/td&gt;&lt;td&gt;CAGR&lt;/td&gt;&lt;td&gt;Sharpe&lt;/td&gt;&lt;td&gt;Max drawdown&lt;/td&gt;&lt;td&gt;10-bps CAGR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1 session&lt;/b&gt;&lt;/td&gt;&lt;td&gt;751&lt;/td&gt;&lt;td&gt;0.076%&lt;/td&gt;&lt;td&gt;53.9%&lt;/td&gt;&lt;td&gt;64.66%&lt;/td&gt;&lt;td&gt;18.19%&lt;/td&gt;&lt;td&gt;0.99&lt;/td&gt;&lt;td&gt;−25.58%&lt;/td&gt;&lt;td style=&quot;color:#B64A4A;font-weight:bold&quot;&gt;−8.66%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;5 sessions&lt;/b&gt;&lt;/td&gt;&lt;td&gt;150&lt;/td&gt;&lt;td&gt;0.504%&lt;/td&gt;&lt;td&gt;61.3%&lt;/td&gt;&lt;td&gt;105.83%&lt;/td&gt;&lt;td&gt;27.37%&lt;/td&gt;&lt;td&gt;1.37&lt;/td&gt;&lt;td&gt;−28.41%&lt;/td&gt;&lt;td&gt;20.64%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;20 sessions&lt;/b&gt;&lt;/td&gt;&lt;td&gt;37&lt;/td&gt;&lt;td&gt;1.679%&lt;/td&gt;&lt;td&gt;62.2%&lt;/td&gt;&lt;td&gt;79.23%&lt;/td&gt;&lt;td&gt;21.60%&lt;/td&gt;&lt;td&gt;1.12&lt;/td&gt;&lt;td&gt;−24.21%&lt;/td&gt;&lt;td&gt;19.79%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D7A57;strokeWidth=2;fontColor=#1F2937;fontSize=13;align=center;verticalAlign=middle;spacing=12;arcSize=8;overflow=fill;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="1780" height="210" as="geometry"/></mxCell>
        <mxCell id="p4-note" value="Episode means describe one completed holding period; CAGR describes repeated reinvestment. The monthly estimate has only 37 complete holdout episodes and is therefore much less precise than the daily estimate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=1;fontColor=#334155;fontSize=13;align=center;verticalAlign=middle;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="405" width="1320" height="46" as="geometry"/></mxCell>

        <mxCell id="p4-bootstrap" value="&lt;b&gt;PAIRED GROSS-RETURN BLOCK-BOOTSTRAP TEST&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr style=&quot;background:#EDE9FE;font-weight:bold&quot;&gt;&lt;td&gt;h&lt;/td&gt;&lt;td&gt;Comparator&lt;/td&gt;&lt;td&gt;Δ pp/year&lt;/td&gt;&lt;td&gt;95% interval&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Universe&lt;/td&gt;&lt;td&gt;+1.96&lt;/td&gt;&lt;td&gt;[−11.01, 15.02]&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FDECEC&quot;&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Equal blend&lt;/td&gt;&lt;td&gt;&lt;b&gt;−8.90&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;[−15.52, −2.24]&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;Universe&lt;/td&gt;&lt;td&gt;+9.50&lt;/td&gt;&lt;td&gt;[−5.03, 23.72]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;Equal blend&lt;/td&gt;&lt;td&gt;+0.53&lt;/td&gt;&lt;td&gt;[−9.51, 8.84]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;Universe&lt;/td&gt;&lt;td&gt;+4.97&lt;/td&gt;&lt;td&gt;[−8.05, 18.62]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;Equal blend&lt;/td&gt;&lt;td&gt;−3.26&lt;/td&gt;&lt;td&gt;[−11.08, 4.10]&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Finding:&lt;/b&gt; only the daily ensemble-versus-equal-blend interval excludes zero, and it favors the simpler blend. No ensemble-versus-universe interval excludes zero." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=13;align=left;verticalAlign=top;spacing=14;arcSize=8;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="600" height="430" as="geometry"/></mxCell>
        <mxCell id="p4-cost" value="&lt;b&gt;TRANSACTION-COST STRESS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Mean daily traded notional&lt;/b&gt;&lt;br&gt;1 session: 102.31% of prior NAV&lt;br&gt;5 sessions: 21.52%&lt;br&gt;20 sessions: 5.91%&lt;br&gt;&lt;br&gt;&lt;b&gt;CAGR loss at 10 bps per dollar traded&lt;/b&gt;&lt;br&gt;1 session: −26.85 pp&lt;br&gt;5 sessions: −6.73 pp&lt;br&gt;20 sessions: −1.80 pp&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B64A4A&quot;&gt;&lt;b&gt;Daily conclusion:&lt;/b&gt; valid under the assignment's zero-cost rule, but not economically robust to the illustrative fee.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=13;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="670" y="480" width="370" height="430" as="geometry"/></mxCell>
        <mxCell id="p4-calendar" value="&lt;b&gt;MONTHLY CALENDAR SENSITIVITY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nov 6 → Dec 4, 2026 contains &lt;b&gt;19 post-entry NYSE sessions&lt;/b&gt; because Thanksgiving is closed; 20 is a conventional month proxy.&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr style=&quot;background:#FFF6DF;font-weight:bold&quot;&gt;&lt;td&gt;h&lt;/td&gt;&lt;td&gt;Ensemble CAGR&lt;/td&gt;&lt;td&gt;Equal blend&lt;/td&gt;&lt;td&gt;Universe&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;19&lt;/td&gt;&lt;td&gt;26.27%&lt;/td&gt;&lt;td&gt;31.06%&lt;/td&gt;&lt;td&gt;16.97%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;21.60%&lt;/td&gt;&lt;td&gt;25.53%&lt;/td&gt;&lt;td&gt;16.91%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;21&lt;/td&gt;&lt;td&gt;18.68%&lt;/td&gt;&lt;td&gt;19.45%&lt;/td&gt;&lt;td&gt;17.10%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;All ensemble-minus-universe intervals include zero. Changing h changes both labels and rebalance phase. Pre-specify 19 exact or 20 conventional; never choose after seeing outcomes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DF;strokeColor=#B58119;strokeWidth=2;fontColor=#5F4309;fontSize=13;align=left;verticalAlign=top;spacing=14;arcSize=8;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1070" y="480" width="470" height="430" as="geometry"/></mxCell>
        <mxCell id="p4-model" value="&lt;b&gt;MODEL DIAGNOSTICS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mean holdout weights at all horizons:&lt;br&gt;≈56% earnings • 17–18% momentum • 26% reversal&lt;br&gt;&lt;br&gt;Latest downloaded session: all three horizon models chose the same top five — ORCL, IBM, MSFT, GS, AMZN.&lt;br&gt;&lt;br&gt;Gate minus ungated annualized gross differences: +0.17, +0.32, +0.03 pp; every interval includes zero.&lt;br&gt;&lt;br&gt;&lt;b&gt;Historical exact-date check (2025)&lt;/b&gt;&lt;br&gt;1 session −0.534% → $994,658&lt;br&gt;5 sessions −0.047% → $999,535&lt;br&gt;to Dec 4 +1.365% → $1,013,648&lt;br&gt;&lt;br&gt;One event validates mechanics, not expected return." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=13;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1570" y="480" width="310" height="430" as="geometry"/></mxCell>

        <mxCell id="p4-verdict" value="&lt;b&gt;VERDICT — FIT FOR THE COURSE DECISION, NOT VALIDATED ALPHA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Operationally fit:&lt;/b&gt; explicit horizons, purged chronology, nominal closes, exact exits, top-five/full-investment constraints, auditable holdings and outputs.&lt;br&gt;&lt;b&gt;Empirically unresolved:&lt;/b&gt; weekly/monthly point estimates are encouraging, but benchmark intervals include zero; daily learned weights lose to the equal blend and are cost-fragile; gate benefit is undetected.&lt;br&gt;&lt;b&gt;External-validity limits:&lt;/b&gt; present-day 30-stock survivor universe, no delisted/history membership, free-vendor revisions, incomplete ledger for spin-offs/mergers/special distributions, only 37 complete monthly holdout episodes, no multiple-testing correction.&lt;br&gt;&lt;b&gt;Defensible claim:&lt;/b&gt; a horizon-aligned exploratory decision system with reproducible evidence — not proof of future profitability or return maximization." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF2E6;strokeColor=#2F7D4A;strokeWidth=3;fontColor=#174529;fontSize=13;align=left;verticalAlign=middle;spacing=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="935" width="1420" height="105" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="runbook" name="5. Live Runbook and Output Contract">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p5-title" value="Operational Runbook, Repository Map and Desired Deliverables" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1840" height="42" as="geometry"/></mxCell>
        <mxCell id="p5-subtitle" value="Use this page as the implementation checklist for reproducible research, live ranking and exact-date course submission." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52677A;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1800" height="28" as="geometry"/></mxCell>

        <mxCell id="p5-cmd-bg" value="&lt;b&gt;A • COMMAND WORKFLOW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#17324D;fontSize=18;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="1840" height="300" as="geometry"/></mxCell>
        <mxCell id="p5-env" value="&lt;b&gt;1 • Reproduce environment&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;uv sync --frozen --extra dev&lt;/font&gt;&lt;br&gt;Python ≥3.11; lockfile-pinned dependencies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#356A9A;strokeWidth=2;fontColor=#17324D;fontSize=12;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="75" y="180" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="p5-download" value="&lt;b&gt;2 • Refresh completed data&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;export SEC_USER_AGENT=...&lt;br&gt;uv run stock-ensemble download --end 2026-11-07&lt;/font&gt;&lt;br&gt;exclusive end; archive snapshot + manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F5;strokeColor=#277C7C;strokeWidth=2;fontColor=#174E4E;fontSize=12;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="385" y="170" width="315" height="140" as="geometry"/></mxCell>
        <mxCell id="p5-test" value="&lt;b&gt;3 • Verify research path&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;uv run --extra dev pytest -q&lt;br&gt;uv run stock-ensemble backtest&lt;/font&gt;&lt;br&gt;review metrics, intervals, holdings and manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=12;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="p5-rank" value="&lt;b&gt;4 • Inspect latest signal&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;uv run stock-ensemble rank&lt;br&gt;  --output results/latest&lt;/font&gt;&lt;br&gt;date is latest downloaded completed session, not necessarily today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#6B4FA1;strokeWidth=2;fontColor=#3F2D63;fontSize=12;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="170" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="p5-allocate" value="&lt;b&gt;5 • Lock assignment portfolios&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;uv run stock-ensemble allocate&lt;br&gt;  --entry-date 2026-11-06&lt;br&gt;  --exit-dates 2026-11-09 2026-11-13 2026-12-04&lt;br&gt;  --output results/assignment_2026&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#3D7A57;strokeWidth=2;fontColor=#245238;fontSize=12;align=left;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1420" y="155" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="p5-e1" value="→" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="345" y="210" width="40" height="60" as="geometry"/></mxCell>
        <mxCell id="p5-e2" value="→" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="700" y="210" width="40" height="60" as="geometry"/></mxCell>
