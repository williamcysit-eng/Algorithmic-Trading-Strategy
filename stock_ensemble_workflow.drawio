        <mxCell id="p5-future" value="Future market data are never fabricated. Before an exit exists, status remains pending. Re-run after each exit date to calculate realized nominal-price returns and dividend notifications; preserve the originally locked rankings, allocations and raw snapshot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#B64A4A;strokeWidth=2;fontColor=#6E2525;fontSize=12;align=center;verticalAlign=middle;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="330" width="1420" height="65" as="geometry"/></mxCell>

